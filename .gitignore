# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# 번들 크기 측정용 빌드(NEXT_DIST_DIR) — 개발 서버의 .next 와 섞이지 않게 따로 둔다
/.next-perf*/
/.next-probe*/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 백업 폴더(npm run backup) — 고객 자료가 들어 있다. 저장소에 올리지 않는다.
/ems-backup/
ems-backup/

# 실제 명함 스캔 PDF — **실제 인물 정보**다. 저장소에도 docs/ 에도 들이지 않는다.
# (2026-11-24 실측에 쓴 원본은 저장소 바깥에 둔다 — 바탕화면)
*명함*.pdf
